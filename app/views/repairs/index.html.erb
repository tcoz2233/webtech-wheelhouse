<% provide(:title, "Reparations list") %>

<h1 class="mb-4">Reparations</h1>

<% if @repairs.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Bikes</th>
        <th>Client</th>
        <th>Mechanic</th>
        <th>Status</th>
        <th>Promised date</th>
      </tr>
    </thead>
    <tbody>
      <% @repairs.each do |repair| %>
        <%# Criterio visual: marcar en rojo si la fecha prometida ya pasó y no se ha entregado %>
        <% is_overdue = repair.promised_on < Date.today && repair.status != "delivered" %>
        <tr class="<%= 'table-danger' if is_overdue %>">
          <td><%= link_to "##{repair.id}", repair_path(repair), class: "fw-bold" %></td>
          <td><%= link_to "#{repair.bike.brand} #{repair.bike.model}", bike_path(repair.bike) %></td>
          <td><%= link_to repair.bike.customer.name, customer_path(repair.bike.customer) %></td>
          <td><%= repair.mechanic ? link_to(repair.mechanic.name, mechanic_path(repair.mechanic)) : "Sin asignar" %></td>
          <td><span class="badge bg-secondary"><%= repair.status %></span></td>
          <td><%= l(repair.promised_on, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">There is no reparations in the system.</p>
<% end %>