<% provide(:title, "Reparación ##{@repair.id}") %>

<div class="mb-3">
  <%= link_to "← Volver a Reparaciones", repairs_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<h1>Reparación #<%= @repair.id %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Bicicleta:</strong> <%= link_to "#{@repair.bike.brand} #{@repair.bike.model}", bike_path(@repair.bike) %></p>
    <p><strong>Cliente:</strong> <%= link_to @repair.bike.customer.name, customer_path(@repair.bike.customer) %></p>
    <p><strong>Mecánico:</strong> <%= @repair.mechanic ? link_to(@repair.mechanic.name, mechanic_path(@repair.mechanic)) : "Sin asignar" %></p>
    <p><strong>Estado:</strong> <%= @repair.status %></p>
    <p><strong>Prometida para:</strong> <%= l(@repair.promised_on, format: :long) %></p>
  </div>
</div>

<h3>Servicios Cobrados</h3>
<% if @repair.repair_line_items.any? %>
  <table class="table table-sm">
    <thead>
      <tr>
        <th>Servicio</th>
        <th class="text-end">Precio Cobrado</th>
      </tr>
    </thead>
    <tbody>
      <% total = 0 %>
      <% @repair.repair_line_items.each do |item| %>
        <% total += item.price %>
        <tr>
          <td><%= link_to item.service.name, service_path(item.service) %></td>
          <td class="text-end"><%= number_to_currency(item.price, unit: "$", precision: 0) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="fw-bold">
        <td>Total</td>
        <td class="text-end"><%= number_to_currency(total, unit: "$", precision: 0) %></td>
      </tr>
    </tfoot>
  </table>
<% else %>
  <p class="text-muted">Esta reparación no posee servicios asociados.</p>
<% end %>