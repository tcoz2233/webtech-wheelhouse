<% provide(:title, @customer.name) %>

<div class="mb-3">
  <%= link_to "← Back to clients", customers_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<h1><%= @customer.name %></h1>

<h3 class="mt-4">Registered bikes</h3>
<% if @customer.bikes.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Model</th>
        <th>Brand</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @customer.bikes %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">This client has no registered bikes.</p>
<% end %>
<%= link_to "Add Bike for this Customer", new_bike_path(customer_id: @customer.id), class: "btn btn-sm btn-outline-primary" %>
<%= link_to "Delete", customer_path(@customer), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete customer '#{@customer.name}'?" }, class: "btn btn-danger" %>