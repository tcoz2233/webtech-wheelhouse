<%= form_with(model: customer, local: true) do |f| %>
  <%= render 'shared/errors', object: customer %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{'is-invalid' if customer.errors[:name].any?}" %>
    <% customer.errors[:name].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :phone, class: "form-label" %>
    <%= f.telephone_field :phone, class: "form-control #{'is-invalid' if customer.errors[:phone].any?}" %>
    <% customer.errors[:phone].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", customer.persisted? ? customer_path(customer) : customers_path, class: "btn btn-secondary" %>
  </div>
<% end %>