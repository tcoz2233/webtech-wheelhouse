<% provide(:title, "#{@bike.brand} #{@bike.model}") %>

<div class="mb-3">
  <%= link_to "← Volver a Bicicletas", bikes_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<h1><%= @bike.brand %> <%= @bike.model %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Dueño:</strong> <%= link_to_if policy(@bike.customer).show?, @bike.customer.name, customer_path(@bike.customer) %></p>
  </div>
</div>

<h3>Historial de Reparaciones</h3>
<% if @repairs.any? %>
  <ul class="list-group">
    <% @repairs.each do |repair| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to_if policy(repair).show?, "Reparación ##{repair.id} - Prometida: #{l(repair.promised_on, format: :short)}", repair_path(repair) %>
        <span class="badge bg-secondary"><%= repair.status %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">Esta bicicleta no tiene reparaciones registradas.</p>
<% end %>
<% if policy(Repair).create? %>
  <%= link_to "New Repair for this Bike", new_repair_path(bike_id: @bike.id), class: "btn btn-sm btn-outline-primary" %>
<% end %>
<% if policy(@bike).update? %>
  <%= link_to "Edit", edit_bike_path(@bike), class: "btn btn-primary" %>
<% end %>
<% if policy(@bike).destroy? %>
  <%= link_to "Delete", bike_path(@bike), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this bike?" }, class: "btn btn-outline-danger" %>
<% end %>