<% provide(:title, "#{@bike.brand} #{@bike.model}") %>

<div class="mb-3">
  <%= link_to "← Volver a Bicicletas", bikes_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<h1><%= @bike.brand %> <%= @bike.model %></h1>

<div class="card mb-4">
  <div class="card-body">
    <p><strong>Dueño:</strong> <%= link_to @bike.customer.name, customer_path(@bike.customer) %></p>
  </div>
</div>

<h3>Historial de Reparaciones</h3>
<% if @bike.repairs.any? %>
  <ul class="list-group">
    <% @bike.repairs.each do |repair| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to "Reparación ##{repair.id} - Prometida: #{l(repair.promised_on, format: :short)}", repair_path(repair) %>
        <span class="badge bg-secondary"><%= repair.status %></span>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">Esta bicicleta no tiene reparaciones registradas.</p>
<% end %>