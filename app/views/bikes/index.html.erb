<% provide(:title, "All bikes") %>

<h1 class="mb-4">Bikes</h1>

<% if @bikes.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Model</th>
        <th>Brand</th>
        <th>Owner</th>
      </tr>
    </thead>
    <tbody>
      <%= render @bikes %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">There is no bikes registered in the system.</p>
<% end %>