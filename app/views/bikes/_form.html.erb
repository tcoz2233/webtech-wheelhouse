<%= form_with(model: bike, local: true) do |f| %>
  <%= render 'shared/errors', object: bike %>

  <div class="mb-3">
    <%= f.label :customer_id, "Owner", class: "form-label" %>
    <%= f.collection_select :customer_id, Customer.by_name, :id, :name, { prompt: "Select Customer" }, { class: "form-select #{'is-invalid' if bike.errors[:customer_id].any?}" } %>
    <% bike.errors[:customer_id].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :brand, class: "form-label" %>
    <%= f.text_field :brand, class: "form-control #{'is-invalid' if bike.errors[:brand].any?}" %>
    <% bike.errors[:brand].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :model, class: "form-label" %>
    <%= f.text_field :model, class: "form-control #{'is-invalid' if bike.errors[:model].any?}" %>
    <% bike.errors[:model].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :serial_number, class: "form-label" %>
    <%= f.text_field :serial_number, class: "form-control #{'is-invalid' if bike.errors[:serial_number].any?}" %>
    <% bike.errors[:serial_number].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", bike.persisted? ? bike_path(bike) : bikes_path, class: "btn btn-secondary" %>
  </div>
<% end %>