<% provide(:title, @mechanic.name) %>

<div class="mb-3">
  <%= link_to "← Volver a Mecánicos", mechanics_path, class: "btn btn-outline-secondary btn-sm" %>
</div>

<h1><%= @mechanic.name %></h1>

<h3 class="mt-4">Reparaciones Asignadas</h3>
<% if @repairs.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Bicicleta</th>
        <th>Estado</th>
        <th>Fecha Prometida</th>
      </tr>
    </thead>
    <tbody>
      <% @repairs.each do |repair| %>
        <tr>
          <td><%= link_to_if policy(repair).show?, "##{repair.id}", repair_path(repair), class: "fw-bold" %></td>
          <td><%= link_to_if policy(repair.bike).show?, "#{repair.bike.brand} #{repair.bike.model}", bike_path(repair.bike) %></td>
          <td><span class="badge bg-secondary"><%= repair.status %></span></td>
          <td><%= l(repair.promised_on, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">Este mecánico no tiene reparaciones asignadas.</p>
<% end %>