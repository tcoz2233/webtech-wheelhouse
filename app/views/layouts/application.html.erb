<!DOCTYPE html>
<html>
  <head>
    <title>Wheelhouse Bicycle Shop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application.bootstrap", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
      <div class="container">
        <%= link_to "Wheelhouse", root_path, class: "navbar-brand fw-bold" %>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Home", root_path, class: "nav-link #{'active' if current_page?(root_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Visiting", visiting_path, class: "nav-link #{'active' if current_page?(visiting_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "About Us", about_path, class: "nav-link #{'active' if current_page?(about_path)}" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container mb-5 flex-grow-1">
      <%= yield %>
    </main>

    <footer class="text-center text-muted py-3 border-top mt-auto">
      <small>&copy; <%= Time.current.year %> Wheelhouse Bicycle Shop</small>
    </footer>
  </body>
</html>