<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Wheelhouse Garage" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application.bootstrap", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <!-- Brand / Home Link -->
    <%= link_to "Wheelhouse", root_path, class: "navbar-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <%= link_to "Customers", customers_path, class: "nav-link #{'active' if current_page?(customers_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "Bikes", bikes_path, class: "nav-link #{'active' if current_page?(bikes_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "Mechanics", mechanics_path, class: "nav-link #{'active' if current_page?(mechanics_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "Repairs", repairs_path, class: "nav-link #{'active' if current_page?(repairs_path)}" %>
        </li>
        <li class="nav-item">
          <%= link_to "Services", services_path, class: "nav-link #{'active' if current_page?(services_path)}" %>
        </li>
      </ul>
    </div>
  </div>
</nav>
    <main class="container mb-5 flex-grow-1">
      <%= yield %>
    </main>

    <footer class="text-center text-muted py-3 border-top mt-auto">
      <small>&copy; <%= Time.current.year %> Wheelhouse Bicycle Shop</small>
    </footer>
  </body>
</html>