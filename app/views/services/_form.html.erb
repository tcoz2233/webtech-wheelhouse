<%= form_with(model: service, local: true) do |f| %>
  <%= render 'shared/errors', object: service %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control #{'is-invalid' if service.errors[:name].any?}" %>
    <% service.errors[:name].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= f.label :current_price, "Current Price ($)", class: "form-label" %>
    <%= f.number_field :current_price, step: "0.01", class: "form-control #{'is-invalid' if service.errors[:current_price].any?}" %>
    <% service.errors[:current_price].each do |error| %>
      <div class="invalid-feedback"><%= error %></div>
    <% end %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :is_active, class: "form-check-input" %>
    <%= f.label :is_active, "Active in Catalog", class: "form-check-label" %>
  </div>

  <div class="d-flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", service.persisted? ? service_path(service) : services_path, class: "btn btn-secondary" %>
  </div>
<% end %>