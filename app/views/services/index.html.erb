<% provide(:title, "Services catalog") %>

<h1 class="mb-4">Services</h1>

<% if @services.any? %>
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Service</th>
        <th>Price</th>
      </tr>
    </thead>
    <tbody>
      <% @services.each do |service| %>
        <tr>
          <td><%= link_to service.name, service_path(service), class: "fw-bold text-decoration-none" %></td>
          <td><%= number_to_currency(service.current_price, unit: "$", precision: 0) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">There are no services registered in the catalog.</p>
<% end %>