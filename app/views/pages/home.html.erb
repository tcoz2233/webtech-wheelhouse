<h1 class="mb-4">Welcome to Wheelhouse</h1>
<div class="row g-4">
  <div class="col-md-8">
    <p class="lead">Your trusted neighborhood bicycle repair shop. We keep your bike running smoothly with expert diagnostics and straightforward pricing.</p>
    <div class="d-flex gap-2 mt-4">
      <%= link_to "View Service Menu", services_path, class: "btn btn-primary btn-lg" %>
      <%= link_to "Visit the Workshop", visiting_path, class: "btn btn-outline-secondary btn-lg" %>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card bg-light border-0 p-3">
      <h2>Quick Info</h2>
      <p class="mb-1"><strong>Location:</strong> Neighborhood Workshop</p>
      <p class="mb-0"><strong>Public Info:</strong> Transparent service pricing with no hidden fees.</p>
    </div>
  </div>
</div>